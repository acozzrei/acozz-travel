// Travel Itinerary app data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id          String          @id @default(cuid())
  name        String
  // URL-friendly identifier used in /trips/[slug] and /share/[slug] instead
  // of the raw id. Assigned once at creation from the trip name and kept
  // stable even if the trip is later renamed, so links don't break.
  slug        String?         @unique
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  coverPhoto  String?
  // Non-null = sharing is turned on for this trip (visible at /share/[slug],
  // no login required to view). Null = not shared. The value itself isn't
  // used as part of the URL anymore — it's just an on/off flag plus a way to
  // instantly revoke by clearing it back to null.
  shareToken  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       ItineraryItem[]
}

model ItineraryItem {
  id            String   @id @default(cuid())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId        String
  type          String   // "activity" | "event" | "dinner" | "lodging" | "transport" | "other"
  title         String
  venueName     String?
  address       String?
  lat           Float?
  lng           Float?
  startTime     DateTime?
  endTime       DateTime?
  partySize     Int?
  notes         String?
  confirmationNo String?
  photoUrl      String?
  photoSource   String?  // "places" | "streetview" | "email" | "placeholder" | "manual"
  sourceEmailId String?
  sourceSender  String?
  status        String   @default("confirmed") // "confirmed" | "canceled" | "changed" | "pending"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tripId])
}

// Single-row table holding app-wide configuration (API keys, Gmail OAuth tokens).
// Single-user app, so one row is enough.
model Settings {
  id                    Int      @id @default(1)
  googleMapsApiKey      String?
  gmailClientId         String?
  gmailClientSecret     String?
  gmailRefreshToken     String?
  gmailConnectedEmail   String?
  anthropicApiKey       String?
  updatedAt             DateTime @updatedAt
}

// Emails already reviewed during Gmail import, so re-scanning the inbox
// doesn't keep re-surfacing the same message as a new candidate.
model ImportedEmail {
  id           String   @id @default(cuid())
  gmailMsgId   String   @unique
  decision     String   // "imported" | "dismissed"
  itineraryId  String?
  createdAt    DateTime @default(now())
}
